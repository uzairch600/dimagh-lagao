# Copy this file to .env and fill in. Never share .env or paste these values in chat.

# Claude Haiku key for generating quiz questions (game works without it using built-in questions)
ANTHROPIC_API_KEY=

# Supabase Postgres connection string
# Supabase > Project Settings > Database > Connection string > "Session pooler" (URI).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# true = "Add money" is fake (for testing). Set to false once a real payment gateway is connected.
DEMO_MODE=true

# How many AI questions to keep ready per category
QUESTION_POOL_SIZE=300

# Highest entry fee the app will cover itself when no real opponent is found
HOUSE_MAX_ENTRY=100

PORT=3000
