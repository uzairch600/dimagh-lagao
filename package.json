  "private": true,
  "description": "1v1 skill quiz battles with a wallet - Next.js + Socket.io",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "build": "next build",
    "start": "node --env-file-if-exists=.env server.js --prod",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
